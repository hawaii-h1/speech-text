#!/bin/sh
# SPDX-FileCopyrightText: 2026 Vladyslav Husakov
# SPDX-License-Identifier: GPL-3.0-or-later
#
# The checks a commit can be put through on its own, in the fraction of a second
# before it is written. Everything slower (the test suite) stays in CI, so
# committing never becomes something to avoid.
#
# Checks run against the *staged* content, not the working tree, so a half-finished
# edit sitting next to a clean commit cannot fail it.
#
# Enable: git config core.hooksPath .githooks
# Bypass once: git commit --no-verify

pbxproj=SpeechText/SpeechText.xcodeproj/project.pbxproj
failed=0

note() {
    printf '%s\n' "$1" >&2
    failed=1
}

staged_content() { git show ":$1" 2>/dev/null; }
is_staged() { git diff --cached --name-only | grep -Fxq "$1"; }

# 1. Xcode puts the signing team back into project.pbxproj whenever a build
#    setting changes, and the repo has to build for anyone who clones it.
if is_staged "$pbxproj"; then
    team=$(staged_content "$pbxproj" | grep -nE 'DEVELOPMENT_TEAM = "?[A-Z0-9]')
    if [ -n "$team" ]; then
        note "project.pbxproj carries a DEVELOPMENT_TEAM:"
        printf '%s\n' "$team" >&2
        note "Revert that hunk — the tracked project keeps it empty on purpose."
    fi
fi

added_swift=$(git diff --cached --name-only --diff-filter=A | grep '\.swift$')

for file in $added_swift; do
    # 2. Every source file opens with the two-line SPDX header — after the
    #    `// swift-tools-version` line in a Package.swift, which SwiftPM requires first.
    case $file in
        */Package.swift|Package.swift) header=$(staged_content "$file" | sed -n '2,3p') ;;
        *) header=$(staged_content "$file" | head -2) ;;
    esac
    case $header in
        *SPDX-FileCopyrightText*)
            case $header in
                *SPDX-License-Identifier*) ;;
                *) note "$file is missing the SPDX-License-Identifier line." ;;
            esac
            ;;
        *) note "$file is missing the two-line SPDX header." ;;
    esac

    # 3. A new app source file that is in no target builds for nobody. Files under
    #    Packages/SpeechTextCore are not in the project at all — the package compiles
    #    whatever is there — so they are not asked; logic the tests need goes there.
    case $file in
        SpeechText/SpeechText/*.swift|SpeechText/SpeechTextTests/*.swift)
            name=${file##*/}
            if ! staged_content "$pbxproj" | grep -Fq "$name"; then
                note "$name is in no target: add it to the Sources phase in $pbxproj"
                note "(or, if it is logic the tests need, put it in Packages/SpeechTextCore — see docs/development.md)."
            fi
            ;;
    esac

    # 4. The app imports SpeechTextCore, so a file in one named like a file in the
    #    other usually declares the same type twice, and the compiler then reports
    #    an ambiguity far from the cause — or a file copied rather than moved. Read
    #    from the index, so a `git mv` from the app into the package passes.
    name=${file##*/}
    case $file in
        SpeechText/SpeechText/*.swift) other=Packages/SpeechTextCore/Sources ;;
        Packages/SpeechTextCore/Sources/*.swift) other=SpeechText/SpeechText ;;
        *) other= ;;
    esac
    if [ -n "$other" ]; then
        twin=$(git ls-files -- "$other" | awk -F/ -v name="$name" '$NF == name { print; exit }')
        if [ -n "$twin" ]; then
            note "$file has the same name as $twin."
            note "Rename one, or move the file with git mv instead of copying it."
        fi
    fi
done

if [ "$failed" -ne 0 ]; then
    printf '\nCommit refused by .githooks/pre-commit. Bypass with --no-verify.\n' >&2
    exit 1
fi
